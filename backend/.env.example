DATABASE_URL="postgresql://app:app@localhost:5434/booking_cv"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="change-me"
PORT=3020
NODE_ENV="development"

# Links in e-mails point here (scripts/dev.mjs sets it to the frontend dev port)
APP_URL="http://localhost:3000"

# Mailpit from docker-compose.yml catches every e-mail: http://localhost:8025
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Booking <no-reply@booking.local>"
